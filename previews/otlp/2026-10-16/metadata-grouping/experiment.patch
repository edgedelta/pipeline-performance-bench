+    #[test]
+    fn grouping_fast_path_preserves_mixed_metadata() {
+        for groups in [1, 8, 64, 512] {
+            for separate in [false, true] {
+                let items = batch(groups, separate);
+                assert_eq!(encode_grouped::<true>(&items), encode_grouped::<false>(&items), "groups={groups} separate={separate}");
+                assert_eq!(ExportMetricsServiceRequest::decode(encode(&items).unwrap().as_slice()).unwrap(), build_requests(&items).1.unwrap());
+            }
+        }
+        for field in ["name", "unit", "description", "kind", "temporality", "monotonic", "resource"] {
+            let mut items = batch(1, false);
+            for item in &mut items {
+                let Item::Metric(m) = item else { unreachable!() };
+                m.kind = MetricKind::Sum;
+                m.value = MetricValue::Sum { value: 1.0, is_monotonic: true, temporality: Temporality::Delta };
+            }
+            let Item::Metric(m) = &mut items[511] else { unreachable!() };
+            match field {
+                "name" => m.name = "other".into(),
+                "unit" => m.unit = "By".into(),
+                "description" => m.description = "other".into(),
+                "kind" => { m.kind = MetricKind::Gauge; m.value = MetricValue::Gauge(1.0); },
+                "temporality" => m.value = MetricValue::Sum { value: 1.0, is_monotonic: true, temporality: Temporality::Cumulative },
+                "monotonic" => m.value = MetricValue::Sum { value: 1.0, is_monotonic: false, temporality: Temporality::Delta },
+                "resource" => { Arc::make_mut(&mut m.resource).insert("other".into(), "value".into()); },
+                _ => unreachable!(),
+            }
+            assert_eq!(encode_grouped::<true>(&items), encode_grouped::<false>(&items), "changed {field}");
+            assert_eq!(ExportMetricsServiceRequest::decode(encode(&items).unwrap().as_slice()).unwrap(), build_requests(&items).1.unwrap(), "changed {field}");
+        }
+    }
