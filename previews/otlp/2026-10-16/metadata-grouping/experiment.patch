+    #[test]
+    #[ignore = "manual release-mode encoder microbenchmark"]
+    fn benchmark_output_grouping() {
+        use std::{hint::black_box, time::Instant};
+        for (groups, late_mismatch) in [(1, false), (8, false), (64, false), (512, false), (1, true)] {
+            let mut items = batch(groups, false);
+            if late_mismatch {
+                let Item::Metric(m) = &mut items[511] else { unreachable!() };
+                m.name = "other".into();
+            }
+            assert_eq!(encode_grouped::<true>(&items), encode_grouped::<false>(&items));
+            let mut times = [Vec::new(), Vec::new()];
+            for round in 0..8 {
+                for mode in [round % 2, 1 - round % 2] {
+                    let start = Instant::now();
+                    for _ in 0..1000 {
+                        black_box(if mode == 0 { encode_grouped::<false>(black_box(&items)) } else { encode_grouped::<true>(black_box(&items)) });
+                    }
+                    times[mode].push(start.elapsed().as_nanos() as f64 / 512_000.0);
+                }
+            }
+            for values in &mut times { values.sort_by(f64::total_cmp); }
+            let old = (times[0][3] + times[0][4]) / 2.0;
+            let new = (times[1][3] + times[1][4]) / 2.0;
+            println!("groups={groups} late_mismatch={late_mismatch} baseline={old:.2} candidate={new:.2} ns/point reduction={:.1}%", 100.0 * (1.0 - new / old));
+        }
+    }
