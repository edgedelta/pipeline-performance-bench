+    #[ignore = "manual metadata representation prototype"]
+    fn benchmark_metadata_sharing() {
+        use std::{hint::black_box, time::Instant};
+        type Metadata = (String, String, String, String);
+        for groups in [1, 8, 64, 512] {
+            let source: Vec<Metadata> = (0..groups).map(|g| (format!("bench.requests.{g}"), "1".into(), String::new(), "sum".into())).collect();
+            let mut times = [Vec::new(), Vec::new()];
+            for round in 0..8 {
+                for mode in [round % 2, 1 - round % 2] {
+                    let start = Instant::now();
+                    for _ in 0..1000 {
+                        if mode == 0 {
+                            black_box((0..512).map(|i| black_box(&source)[i % groups].clone()).collect::<Vec<_>>());
+                        } else {
+                            let shared: Vec<_> = black_box(&source).iter().map(|m| Arc::new(m.clone())).collect();
+                            black_box((0..512).map(|i| Arc::clone(&shared[i % groups])).collect::<Vec<_>>());
+                        }
+                    }
+                    times[mode].push(start.elapsed().as_nanos() as f64 / 512_000.0);
+                }
+            }
+            let shared = Arc::new(source[0].clone());
+            let mut changed = Arc::clone(&shared);
+            Arc::make_mut(&mut changed).0 = "changed".into();
+            assert_eq!(*shared, source[0]);
+            assert_eq!(changed.0, "changed");
+            for values in &mut times { values.sort_by(f64::total_cmp); }
+            let old = (times[0][3] + times[0][4]) / 2.0;
+            let new = (times[1][3] + times[1][4]) / 2.0;
+            println!("groups={groups} owned={old:.2} shared={new:.2} ns/point reduction={:.1}%", 100.0 * (1.0 - new / old));
+        }
+    }
