+    fn batch(groups: usize, separate_resources: bool) -> Vec<Item> {
+        let resources: Vec<_> = (0..groups).map(|g| Arc::new(serde_json::json!({"service.name":format!("service-{g}")}).as_object().unwrap().clone())).collect();
+        (0..512).map(|i| {
+            let g = i % groups;
+            let resource = if separate_resources { Arc::new((*resources[g]).clone()) } else { Arc::clone(&resources[g]) };
+            let mut m = MetricItem::gauge(format!("metric-{g}"), i as f64,
+                serde_json::json!({"host":(i % 64).to_string(),"route":if i % 4 == 0 {"health"} else {"api"}}).as_object().unwrap().clone(), resource);
+            m.timestamp_ms = 1_000; m.unit = if g % 2 == 0 {"s"} else {"By"}.into();
+            Item::Metric(m)
+        }).collect()
+    }
