+/// Read trace fields without copying events, links, or resource maps.
+pub fn with_trace_fields<T>(t: &mut TraceItem, f: impl FnOnce(&LogItem) -> T) -> T {
+    let mut attributes = std::mem::take(&mut t.span.attributes);
+    let borrowed_attributes = t.attributes.is_empty();
+    if !borrowed_attributes {
+        let mut merged = t.attributes.clone();
+        merged.extend(attributes.clone());
+        std::mem::swap(&mut attributes, &mut merged);
+        t.span.attributes = merged;
+    }
+    let view = LogItem {
+        timestamp_ms: t.timestamp_ms, body: None, attributes,
+        resource: Arc::clone(&t.resource),
+        request_resource: std::mem::take(&mut t.span.resources),
+        cache: Map::new(),
+        extra: [("trace.id".into(), t.trace_id.clone().into())].into_iter().collect(),
+    };
+    let result = f(&view);
+    if borrowed_attributes { t.span.attributes = view.attributes; }
+    t.span.resources = view.request_resource;
+    result
+}
