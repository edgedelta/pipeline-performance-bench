+fn trace_expr(e: &CExpr) -> bool {
+    match e {
+        CExpr::Path(p) => matches!(p.root.as_str(), "attributes" | "resource" | "cache" | "timestamp" | "time" | "trace.id")
+            && p.keys.iter().all(|k| match k { CKey::Dyn(e) => trace_expr(e), _ => true }),
+        CExpr::Lit(_) | CExpr::Bytes(_) => true,
+        CExpr::List(xs) => xs.iter().all(trace_expr),
+        CExpr::Map(xs) => xs.iter().all(|(_, e)| trace_expr(e)),
+        CExpr::Neg(e) => trace_expr(e),
+        CExpr::Bin(a, _, b) => trace_expr(a) && trace_expr(b),
+        CExpr::Call(c) => c.spec.name == "EDXSample" && c.args.iter().all(|a| match a {
+            funcs::Arg::None => true, funcs::Arg::Expr(e) => trace_expr(e), _ => false,
+        }),
+        _ => false,
+    }
+}
+
+fn trace_cond(c: &CCond) -> bool {
+    match c {
+        CCond::Cmp(a, _, b) => trace_expr(a) && trace_expr(b),
+        CCond::Truthy(e) => trace_expr(e),
+        CCond::And(a, b) | CCond::Or(a, b) => trace_cond(a) && trace_cond(b),
+        CCond::Not(c) => trace_cond(c),
+    }
+}
+
+impl CompiledCond {
+    /// Whether a condition only reads fields available in the borrowed trace view.
+    pub fn trace_fields_only(&self) -> bool { trace_cond(&self.cond) }
+}
