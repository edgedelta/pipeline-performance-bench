+#[cfg(test)]
+mod trace_tests {
+    use super::*;
+    use crate::item::{context, Item, Map, SpanData, SpanEvent, SpanLink, Stage, TraceItem};
+    use serde_json::json;
+    use std::sync::Arc;
+
+    fn trace() -> TraceItem {
+        TraceItem {
+            extra: serde_json::from_value(json!({"custom": 42})).unwrap(),
+            timestamp_ms: 1700000000000,
+            trace_id: "0123456789abcdef0123456789abcdef".into(), trace_state: "a=b".into(),
+            span: SpanData {
+                span_id: "0123456789abcdef".into(), span_name: "request".into(),
+                attributes: serde_json::from_value(json!({"route": "health", "otel.scope.name": "bench", "otel.scope.version": "1"})).unwrap(),
+                resources: serde_json::from_value(json!({"service": "span"})).unwrap(),
+                events: vec![SpanEvent { name: "checkpoint".into(), time_unix_nano: 17, attributes: Map::new() }],
+                links: vec![SpanLink { trace_id: "abcdef0123456789abcdef0123456789".into(), span_id: "abcdef0123456789".into(), trace_state: String::new(), attributes: Map::new() }],
+                ..Default::default()
+            },
+            resource: Arc::new(serde_json::from_value(json!({"service": "source", "env": "test"})).unwrap()),
+            attributes: Map::new(),
+        }
+    }
+
+    #[test]
+    fn native_trace_conditions_match_full_context_without_mutation() {
+        for attrs in [Map::new(), serde_json::from_value(json!({"route": "other", "item": true})).unwrap()] {
+            for condition in [
+                "attributes[\"route\"] == \"health\"", "resource[\"service\"] == \"span\"",
+                "resource[\"env\"] == \"test\"", "attributes[\"item\"] == true",
+                "EDXSample(50, trace.id)", "EDXSample(100)", "EDXSample(-1, trace.id)",
+                "span.name == \"request\"", "custom == 42", "events != nil",
+                "attributes[cache[\"missing\"]] == nil", "trace.id == \"\"",
+            ] {
+                for mode in ["include", "exclude"] {
+                    let f = OttlFilter::new(condition, mode).unwrap();
+                    let mut t = trace(); t.attributes = attrs.clone();
+                    let before = serde_json::to_value(&t).unwrap();
+                    let expected = f.process(&mut context::from_map(context::trace_map(&t)));
+                    assert_eq!(f.process_trace(&mut t), Some(expected), "{condition} {mode}");
+                    assert_eq!(serde_json::to_value(&t).unwrap(), before, "{condition} {mode}");
+                    let mut out = Vec::new(); f.run(Item::Trace(t), &mut out);
+                    assert_eq!(out.len(), usize::from(expected == Verdict::Keep), "{condition} {mode}");
+                }
+            }
+        }
+    }
+
+    #[test]
+    #[ignore]
+    fn benchmark_trace_filter_context() {
+        use std::{hint::black_box, time::Instant};
+        for condition in ["attributes[\"route\"] == \"health\"", "EDXSample(50, trace.id)"] {
+            let f = OttlFilter::new(condition, "include").unwrap();
+            let mut t = trace();
+            for native in [false, true] {
+                let start = Instant::now();
+                let mut item = Item::Trace(t.clone());
+                for _ in 0..100_000 {
+                    if native { black_box(f.process_trace(black_box(&mut t))); }
+                    else {
+                        let mut view = context::view(&item);
+                        let verdict = f.process(&mut view);
+                        if verdict == Verdict::Keep { context::apply(&mut item, view); }
+                        black_box(&item);
+                    }
+                }
+                println!("condition={condition} native={native} ns/span={:.1}", start.elapsed().as_nanos() as f64 / 100_000.0);
+            }
+        }
+    }
+}
